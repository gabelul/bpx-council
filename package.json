{
  "name": "@booplex/bpx-council",
  "version": "2.2.0",
  "description": "A portable multi-model council CLI — one advisor or a whole debating council, usable from any coding agent (Claude Code, Codex, Cursor, pi).",
  "keywords": [
    "cli",
    "ai",
    "advisor",
    "council",
    "multi-model",
    "consensus",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "gabelul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabelul/bpx-council.git"
  },
  "homepage": "https://github.com/gabelul/bpx-council#readme",
  "bugs": {
    "url": "https://github.com/gabelul/bpx-council/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bpx-council": "./dist/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "scripts/postinstall.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "ink": "6.8.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "string-width": "8.1.1",
    "strip-ansi": "7.1.2"
  }
}
